# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
# Anything else is silently ignored.
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- LLM provider ---
# Local (default): leave OPENROUTER_API_KEY unset — Ollama is used.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-small
OLLAMA_OCR_MODEL=MedAIBase/PaddleOCR-VL:0.9b

# Remote: set OPENROUTER_API_KEY to switch all LLM calls to OpenRouter.
# Ollama vars above are ignored when this key is present.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=mistralai/mistral-small-3.1-24b-instruct
# OPENROUTER_OCR_MODEL=google/gemma-3n-e4b-it:free

# --- API ---
API_PORT=47821
PORT=47821
API_URL=http://localhost:47821

# --- Storage ---
DUCKDB_PATH=./data/mr-carson.duckdb
# LibSQL file backing Mastra Memory (chat history). /new rotates the active thread.
MEMORY_DB_PATH=./data/memory.db
# Receipt uploads dir. Default `/data/uploads` is the Docker volume; set a local
# path when running outside containers so mkdirSync doesn't EACCES on `/`.
UPLOADS_DIR=./data/uploads

# --- Defaults ---
DEFAULT_CURRENCY=GBP
LOG_LEVEL=info
