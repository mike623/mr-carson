# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
# Anything else is silently ignored.
TELEGRAM_ALLOWED_USER_IDS=123456789

# --- Ollama (local LLM + OCR) ---
OLLAMA_BASE_URL=http://localhost:11434
# Text/chat model used for receipt extraction and conversational queries.
OLLAMA_MODEL=mistral-small
# Vision model used for OCR. GLM-OCR is purpose-built for receipts/documents.
OLLAMA_OCR_MODEL=glm-ocr

# --- API ---
API_PORT=3000
API_URL=http://localhost:3000

# --- Storage ---
DUCKDB_PATH=./data/mr-carson.duckdb
# LibSQL file backing Mastra Memory (chat history). /new rotates the active thread.
MEMORY_DB_PATH=./data/memory.db

# --- Defaults ---
DEFAULT_CURRENCY=GBP
LOG_LEVEL=info
