    "@mastra/core": "^1.32.1",
    "@mastra/libsql": "^1.0.0",
    "@mastra/memory": "^1.0.0",
    "@mastra/observability": "^1.11.1",
    "@mastra/duckdb": "^1.0.0",
    "ai": "^4.3.0",
    "hono": "^4.7.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.19.4",
