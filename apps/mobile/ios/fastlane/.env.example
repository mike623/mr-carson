# ---------------------------------------------------------------------------
# fastlane environment template for Mr. Carson iOS delivery.
# Copy to `ios/fastlane/.env` and fill in real values. The real .env is
# gitignored — NEVER commit secrets.
# fastlane auto-loads ios/fastlane/.env when run from the ios/ directory.
# ---------------------------------------------------------------------------

# --- fastlane match (signing) ---------------------------------------------
# Passphrase used to encrypt/decrypt the certificates stored in the match repo.
MATCH_PASSWORD=

# ONLY needed if the ios-certs repo is PRIVATE and you authenticate over HTTPS.
# Base64 of "username:personal_access_token", e.g.:
#   echo -n "YOUR_USER:ghp_xxx" | base64
# Omit entirely if the repo is public or you use SSH keys.
MATCH_GIT_BASIC_AUTHORIZATION=

# Optional override of the certs repo URL (defaults to the public ios-certs).
# MATCH_GIT_URL=https://github.com/YOUR_ORG/ios-certs

# --- App Store Connect API key (.p8) --------------------------------------
# Created in App Store Connect → Users and Access → Integrations → App Store
# Connect API. Used for both match auth and the TestFlight upload.
ASC_KEY_ID=             # the Key ID (e.g. ABC123XYZ9)
ASC_ISSUER_ID=          # the Issuer ID (a UUID shown above the keys table)
ASC_KEY_FILEPATH=       # absolute path to the downloaded AuthKey_XXXX.p8 file

# --- Apple team identifiers ------------------------------------------------
APPLE_TEAM_ID=          # Apple Developer Portal Team ID (Membership page)
ITC_TEAM_ID=            # App Store Connect team ID (numeric; from spaceship)

# --- Optional --------------------------------------------------------------
# Apple ID email. Not required when using the App Store Connect API key above.
APPLE_ID=

# Override the app bundle identifier if it ever differs from the default.
# APP_IDENTIFIER=com.mrcarson.mrCarson
