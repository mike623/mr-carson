default_platform(:ios)

# ---------------------------------------------------------------------------
# Mr. Carson — iOS TestFlight delivery
#
# Signing  : fastlane match (git storage, type "appstore"), certs repo
#            https://github.com/mike623/ios-certs
# Auth     : App Store Connect API key (.p8) — no Apple ID / 2FA, CI-friendly.
#
# Build approach (per the Flutter + Fastlane skills):
#   We build the IPA with the native `build_app` (gym) action driving the
#   Runner.xcworkspace / Runner scheme, AFTER `flutter build ios --release
#   --no-codesign` compiles the Dart/engine artifacts. This lets fastlane own
#   code signing via the match-provisioned profile, instead of `flutter build
#   ipa` guessing at signing — which is the combination the skills recommend
#   when match is in play.
#
# Every credential is read from ENV. NEVER hardcode secrets here.
# See fastlane/.env.example for the required variables.
# ---------------------------------------------------------------------------

platform :ios do
  desc "Provision signing assets via match (read-only, CI-safe)"
  lane :setup_signing do
    setup_ci # creates a temporary keychain in CI; no-op on a normal dev machine
    match(type: "appstore", readonly: true)
  end

  desc "Build and push a new beta build to TestFlight"
  lane :beta do
    # 1. Authenticate to App Store Connect with an API key (.p8). This avoids
    #    Apple ID + 2FA and works unattended in CI.
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )

    # 2. Prepare a clean keychain (CI) and fetch the appstore signing assets.
    setup_ci
    match(type: "appstore", readonly: true, api_key: api_key)

    # 3. Bump the build number based on the latest build already on TestFlight,
    #    so we never collide with a previously uploaded build. Guarded so local
    #    runs still work if TestFlight can't be reached.
    begin
      latest_build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: ENV["APP_IDENTIFIER"] || "com.mrcarson.mrCarson"
      )
      increment_build_number(
        xcodeproj: "Runner.xcodeproj",
        build_number: latest_build + 1
      )
    rescue => e
      UI.important("Could not read TestFlight build number (#{e.message}); falling back to local increment.")
      increment_build_number(xcodeproj: "Runner.xcodeproj")
    end

    # 4. Compile the Flutter iOS artifacts WITHOUT codesigning, then let
    #    fastlane (gym) archive + sign + export the IPA using the match profile.
    sh("cd ../.. && flutter build ios --release --no-codesign")

    ipa_path = build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )

    # 5. Upload to TestFlight. Don't block CI on Apple's processing queue.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: ipa_path
    )
  end

  desc "One-time: generate/store appstore certs in the match repo (read-write). " \
       "Requires WRITE access to the ios-certs repo and an Apple account with " \
       "admin rights. Run this once by the project owner, NOT in CI."
  lane :certificates do
    match(type: "appstore")
  end
end
