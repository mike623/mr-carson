default_platform(:ios)

def app_identifier
  ENV['APP_IDENTIFIER'] || 'com.mrcarson.mrCarson'
end

def match_profile_name
  mapping = Actions.lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING] || {}
  mapping[app_identifier] || "match AppStore #{app_identifier}"
end

def install_signing_assets(api_key)
  # Local dev must not touch keychains: do not create, switch, unlock, delete,
  # reset, or pass explicit keychain settings. Temporary keychain setup belongs
  # only in CI=true-only lanes, never in local beta/build/release lanes.
  # App Store Connect API-key auth avoids Apple ID/2FA, but macOS codesigning
  # still requires the distribution private key to be available through the
  # existing macOS signing environment.
  match(type: "appstore", readonly: true, api_key: api_key)
end

# gym spawns its own xcodebuild, whose Flutter "Run Script" build phase
# (xcode_backend.sh) re-invokes `flutter`. fastlane runs under Homebrew Ruby and
# exports GEM_HOME/GEM_PATH/BUNDLE_GEMFILE, which leak into that subprocess and
# deadlock flutter's dartvm during the archive. Strip those vars (safe: fastlane
# is already loaded) and make sure flutter is on PATH for the embedded call.
def clean_flutter_subprocess_env!
  %w[GEM_HOME GEM_PATH BUNDLE_GEMFILE BUNDLE_BIN_PATH RUBYOPT RUBYLIB].each { |k| ENV.delete(k) }
  ENV["PATH"] = "/opt/homebrew/bin:#{ENV['PATH']}" unless ENV["PATH"].to_s.include?("/opt/homebrew/bin")
end

# ---------------------------------------------------------------------------
# Mr. Carson — iOS TestFlight delivery
#
# Signing  : fastlane match (git storage, type "appstore"), certs repo
#            https://github.com/YOUR_ORG/ios-certs
# Auth     : App Store Connect API key (.p8) — no Apple ID / 2FA, CI-friendly.
#
# Build approach (per the Flutter + Fastlane skills):
#   We build the IPA with the native `build_app` (gym) action driving the
#   Runner.xcworkspace / Runner scheme, AFTER `flutter build ios --release
#   --no-codesign` compiles the Dart/engine artifacts. This lets fastlane own
#   code signing via the match-provisioned profile, instead of `flutter build
#   ipa` guessing at signing — which is the combination the skills recommend
#   when match is in play.
#
# Every credential is read from ENV. NEVER hardcode secrets here.
# See fastlane/.env.example for the required variables.
# ---------------------------------------------------------------------------

platform :ios do
  desc "Provision signing assets via match (read-only, CI-safe)"
  lane :setup_signing do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )
    install_signing_assets(api_key)
  end

  desc "Build a signed App Store IPA WITHOUT uploading (verification only)."
  lane :build do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )
    install_signing_assets(api_key)
    # Pin the Runner target to manual signing with the team + match profile, so
    # `flutter build` (xcodebuild) doesn't error "requires a development team".
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: match_profile_name,
      targets: ["Runner"]
    )
    # Keep the bundler/mise env intact here: this repo has ios/Gemfile, so the
    # Flutter tool runs `bundle exec pod install`, which needs the bundled
    # cocoapods (mise Ruby). Stripping GEM_*/BUNDLE_* drops it to system Ruby 2.6
    # where the bundle isn't installed. The gym step below isolates its own
    # subprocess env via clean_flutter_subprocess_env!.
    sh("cd ../.. && flutter build ios --release --no-codesign")
    clean_flutter_subprocess_env!
    ipa = build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )
    UI.success("Built signed IPA (not uploaded): #{ipa}")
  end

  desc "Build and push a new beta build to TestFlight"
  lane :beta do
    # 1. Authenticate to App Store Connect with an API key (.p8). This avoids
    #    Apple ID + 2FA and works unattended in CI.
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )

    # 2. Fetch the appstore signing assets without explicit keychain handling.
    install_signing_assets(api_key)
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: match_profile_name,
      targets: ["Runner"]
    )

    # 3. Bump the build number based on the latest build already on TestFlight,
    #    so we never collide with a previously uploaded build. Guarded so local
    #    runs still work if TestFlight can't be reached.
    begin
      latest_build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: ENV["APP_IDENTIFIER"] || "com.mrcarson.mrCarson"
      )
      increment_build_number(
        xcodeproj: "Runner.xcodeproj",
        build_number: latest_build + 1
      )
    rescue => e
      UI.important("Could not read TestFlight build number (#{e.message}); falling back to local increment.")
      increment_build_number(xcodeproj: "Runner.xcodeproj")
    end

    # 4. Compile the Flutter iOS artifacts WITHOUT codesigning, then let
    #    fastlane (gym) archive + sign + export the IPA using the match profile.
    # Keep the bundler/mise env intact here: this repo has ios/Gemfile, so the
    # Flutter tool runs `bundle exec pod install`, which needs the bundled
    # cocoapods (mise Ruby). Stripping GEM_*/BUNDLE_* drops it to system Ruby 2.6
    # where the bundle isn't installed. The gym step below isolates its own
    # subprocess env via clean_flutter_subprocess_env!.
    sh("cd ../.. && flutter build ios --release --no-codesign")

    clean_flutter_subprocess_env!
    ipa_path = build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store"
    )

    # 5. Upload to TestFlight. Don't block CI on Apple's processing queue.
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      ipa: ipa_path,
      changelog: File.read(File.expand_path("metadata/en-US/release_notes.txt", __dir__)).strip
    )
  end

  desc "One-time: generate/store appstore certs in the match repo (read-write). " \
       "Requires WRITE access to the ios-certs repo and an Apple account with " \
       "admin rights. Run this once by the project owner, NOT in CI."
  lane :certificates do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )
    # readonly:false so match can create + push the missing cert/profile.
    match(type: "appstore", readonly: false, api_key: api_key)
  end

  desc "One-time: register the App ID on the Developer Portal and create the " \
       "App Store Connect app record (idempotent — skips what already exists)."
  lane :bootstrap do
    # `produce` registers the App ID via the LEGACY Developer Portal (Apple ID +
    # 2FA), which can't run headless. The App Store Connect API key can do both
    # the bundle-id registration and the app-record creation directly through
    # spaceship's ConnectAPI — no Apple-ID login. Idempotent: skips what exists.
    # Sets Spaceship::ConnectAPI.token globally (set_spaceship_token defaults true).
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"],
      in_house: false
    )

    ident = ENV["APP_IDENTIFIER"] || "com.mrcarson.mrCarson"
    name  = ENV["APP_NAME"] || "Mr. Carson"

    bundle = Spaceship::ConnectAPI::BundleId.all.detect { |b| b.identifier == ident }
    if bundle.nil?
      bundle = Spaceship::ConnectAPI::BundleId.create(
        name: name.gsub(/[^0-9A-Za-z ]/, ""), identifier: ident, platform: "IOS"
      )
      UI.success("Registered bundle id #{ident}")
    else
      UI.message("Bundle id #{ident} already registered")
    end

    # NOTE: Apple's App Store Connect API does NOT permit creating app records
    # ('apps' allows only GET/UPDATE). The app record must be created once in the
    # ASC web UI (or via legacy Apple-ID + 2FA `produce`). We detect it here.
    app = Spaceship::ConnectAPI::App.find(ident)
    if app.nil?
      UI.important("App Store Connect record for #{ident} does NOT exist yet.")
      UI.important("Create it once at https://appstoreconnect.apple.com → Apps → +")
      UI.important("  Platform: iOS · Name: '#{name}' · Bundle ID: #{ident} · SKU: #{ENV["APP_SKU"] || "mrcarson"}")
      UI.important("The bundle id is already registered, so it will appear in the dropdown.")
    else
      UI.success("App Store Connect record for #{ident} already exists ✅")
    end
  end
end
